---
import { getCollection } from 'astro:content';
import { projectOrder } from '../data/projects';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import VideoCard from '../components/VideoCard.astro';
import videos from '../data/videos.json';
import { profile } from '../data/profile';
import { imageDimensions } from '../data/media';

const entries = await getCollection('cases');
const projects = projectOrder.map(id => entries.find(entry => entry.id === id)!);
const metaCase = entries.find(entry => entry.id === 'meta-ads')!.data;
const supporting = ['xiaohongshu', 'guilin-towers'].map(id => entries.find(entry => entry.id === id)!);
const brandVideos = videos.filter(video => ['sp06-product', 'power-talk'].includes(video.id));
---
<Base home>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-meta"><span>PERSONAL PORTFOLIO / 2026</span><span class="availability"><i></i>{profile.availability}</span></div>
    <div class="hero-grid">
      <div class="hero-copy"><p class="hero-intro">你好，我是</p><h1 id="hero-title">张泳珺<span class="name-dot">.</span></h1><p class="hero-position">内容增长 <span>·</span> 海外营销<br/><span class="growth-label">AI 应用</span><span class="line-accent" aria-hidden="true"></span></p><p class="hero-description">{profile.description}</p><div class="hero-actions"><a class="button primary" href="#selected">查看精选作品 <span>↗</span></a><a class="quiet-link" href={profile.resume} download="张泳珺_AI内容增长_当前简历.pdf">下载简历 <span>↓</span></a></div><p class="identity">{profile.location}<span>/</span>{profile.year}<span>/</span>{profile.major}</p></div>
      <div class="hero-art" data-parallax>
        <div class="orbit-ring" aria-hidden="true"></div><span class="art-cross cross-one" aria-hidden="true">+</span><span class="art-cross cross-two" aria-hidden="true">+</span>
        <a class="hero-shot shot-back" href="/work/ai-workspace/" data-depth="-0.5"><img src="/images/workspace-demo-1.webp" alt="个人 AI 工作台真实界面" fetchpriority="high"/><span>02 / 个人 AI 工作台 <b>↗</b></span></a>
        <a class="hero-shot shot-middle" href="/work/dewu/" data-depth="0.65"><img src="/images/dewu-content-samples.webp" alt="得物好物内容样本合集" fetchpriority="high"/><span>03 / 账号与商业合作 <b>↗</b></span></a>
        <a class="hero-shot shot-front" href="/work/meta-ads/" data-depth="1"><img src={metaCase.cover} alt={metaCase.coverAlt} {...imageDimensions(metaCase.cover)} fetchpriority="high"/><span>01 / Meta 创意复盘 <b>↗</b></span></a>
        <div class="art-caption"><span class="spark" aria-hidden="true">✳</span><span>想法有形，<br/>内容有回响。</span></div>
        <span class="art-footnote">REAL WORK. REAL PRACTICE.</span>
      </div>
    </div>
    <div class="hero-stats"><div><span class="stat-capability">内容运营</span><strong>17.63<small>万</small></strong><p>账号总阅读 <span>得物历史后台</span></p></div><div><span class="stat-capability">创意交付</span><strong>≈80<small>条 / 周</small></strong><p>素材及衍生版本 <span>本人实习交付记录</span></p></div><div><span class="stat-capability">AI 内容传播</span><strong>1.3<small>万浏览</small></strong><p>工作台教程 <span>小红书笔记后台</span></p></div><div class="stats-note"><span>CREATIVITY<br/>MEETS PRACTICE.</span><a href="#selected" aria-label="向下浏览案例">↓</a></div></div>
  </section>


  <section id="selected" class="section wrap" data-section>
    <div class="section-head">
      <div><p class="eyebrow"><span>01</span> SELECTED WORK</p><h2>精选案例</h2></div>
      <p class="section-aside">广告创意、内容运营与 AI 应用</p>
    </div>
    <div class="case-grid featured-cases">{projects.map(entry => <CaseCard entry={entry}/>)}</div>
    <div class="filmstrip-head">
      <p class="eyebrow">FIVE PROJECTS / 作品索引</p>
      <div class="film-controls">
        <span data-film-count>01 / {String(projects.length).padStart(2, '0')}</span>
        <button data-film-prev aria-label="浏览上一张作品">←</button>
        <button data-film-next aria-label="浏览下一张作品">→</button>
      </div>
    </div>
    <div class="filmstrip" tabindex="0" role="region" aria-label="作品胶卷，可使用左右方向键浏览" data-filmstrip>
      {projects.map(({id, data}) => <a class="film-frame" href={'/work/' + id + '/'} draggable="false">
        <div class="film-perforations" aria-hidden="true"></div>
        <img src={data.cover} alt={data.coverAlt} loading="lazy" draggable="false"/>
        <div class="film-label"><span>{data.number} / {data.shortTitle}</span><span aria-hidden="true">↗</span></div>
      </a>)}
    </div>
  </section>

  <section id="video-work" class="section wrap" data-section>
    <div class="section-head">
      <div><p class="eyebrow"><span>02</span> SUPPORTING WORK</p><h2>补充作品</h2></div>
      <p class="section-aside">品牌视频、个人陪拍与交互实验</p>
    </div>
    <div class="brand-experience">
      <div><h3>ABLPOWER · 产品内容制作</h3><p>从梳理产品功能到脚本、拍摄和剪辑，<br/>用宣传片和口播讲清产品卖点。</p></div>
      <a class="text-link" href="/videos/">查看 ABLPOWER 视频案例 ↗</a>
    </div>
    <div class="video-previews brand-samples">{brandVideos.map(video => <VideoCard video={video} compact/>)}</div>
    <div class="supporting-cases">
      {supporting.map(({id, data}) => <article class="supporting-case">
        <a href={'/work/' + id + '/'}>
          <img src={data.cover} alt={data.coverAlt} {...imageDimensions(data.cover)} loading="lazy"/>
          <div>
            <p class="eyebrow">{id === 'xiaohongshu' ? '个人账号 / 摄影' : 'AI 辅助 / 交互实验'}</p>
            <h3>{data.shortTitle}</h3>
            <p>{id === 'xiaohongshu' ? '用人像作品和陪拍笔记，把拍摄风格与服务信息讲清楚。' : '根据教学场景和试用反馈，迭代浏览器端的建筑观察体验。'}</p>
            <span class="text-link">查看案例 ↗</span>
          </div>
        </a>
      </article>)}
    </div>
  </section>

  <section id="about" class="about-section wrap section" data-section><div class="about-visual" aria-hidden="true"><div class="about-visual-top"><span>07 / BEHIND THE WORK</span><span>ZYJ · 2026</span></div><div class="about-orbit"><i></i><i></i><b>+</b></div><div class="about-type"><span>CONTENT<br/>VIDEO<br/>GROWTH</span></div><div class="about-film"><i></i><i></i><i></i></div><div class="about-visual-foot"><span>IDEA</span><b>→</b><span>MAKE</span><b>→</b><span>PUBLISH</span></div></div><div class="about-copy"><p class="eyebrow"><span>03</span> A LITTLE ABOUT ME</p><h2>有创作者的感知，<br/>也有运营者的思考。</h2><p>2027 届计算机科学与技术本科生，有海外营销素材、Shopline 商品运营、内容创作与个人账号运营经历。用数据整理内容反馈，也用 AI 把具体需求做出来。</p><div class="about-facts"><div><span>2023—2027</span><p><strong>广东理工学院</strong>计算机科学与技术 · 本科<br/>专业前 5% · CET-6</p></div><div><span>2025.06—08</span><p><strong>ABLPOWER · 新媒体运营实习</strong>产品资料梳理、脚本、拍摄剪辑与内容交付</p></div></div><div class="skills">{["Meta 素材复盘","Shopline","商品运营","内容策划","短视频","摄影","剪辑","剪映","Premiere","Photoshop","AIGC","AI 生图","AI 视频","Prompt","AI Coding","小红书","得物","海外社交媒体"].map(skill=><span>{skill}</span>)}</div><div class="contact"><p>期待下一次，一起把想法做出来。</p><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <span>↗</span></a><div class="contact-actions"><button class="quiet-link" data-copy={profile.email}>复制邮箱 ↗</button><button class="quiet-link" data-copy={profile.wechat}>电话 / 微信 {profile.wechat} ⧉</button><a class="quiet-link" href={profile.resume} download="张泳珺_AI内容增长_当前简历.pdf">下载简历 ↓</a></div></div></div></section>
</Base>
