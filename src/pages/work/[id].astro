---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { projectOrder } from '../../data/projects';
export async function getStaticPaths(){return (await getCollection('cases')).map(entry=>({params:{id:entry.id},props:{entry}}));}
interface Props{ entry:CollectionEntry<'cases'>; }
const {entry}=Astro.props;
const d=entry.data;
const entries=await getCollection('cases');
const all=projectOrder.map(id=>entries.find(entry=>entry.id===id)!);
const currentIndex=all.findIndex(x=>x.id===entry.id);
const next=all[(currentIndex+1)%all.length];
---
<Base title={`${d.shortTitle} · 张泳珺作品集`} description={d.summary}>
  <div class="case-page wrap"><a class="back-link" href={currentIndex >= 0 ? '/#selected' : '/#video-work'}>{currentIndex >= 0 ? '← 返回精选案例' : '← 返回补充作品'}</a><header class="case-hero"><p class="eyebrow">{currentIndex >= 0 ? `CASE ${d.number}` : 'SUPPORTING WORK'} / {d.category}</p><h1>{d.title}</h1><p class="case-summary">{d.summary}</p><div class="case-meta"><div><span>我的职责</span><strong>{d.role}</strong></div><div><span>项目周期</span><strong>{d.period}</strong></div></div></header>
  <div class="detail-metrics">{d.metrics.map(m=><div><strong>{m.value}</strong><span>{m.label}</span><small>{m.note}</small></div>)}</div><p class="source-note detail-source">资料来源 / {d.source}</p>
  <div class="case-body">
    <aside class="case-toc"><span class="eyebrow">IN THIS CASE</span><nav aria-label="案例章节">{d.sections.map(s=><a href={`#${s.id}`} data-toc={s.id}>{s.title}</a>)}</nav><span class="toc-footnote">作品 · 过程 · 证据</span></aside>
    <div class="case-article">
      {d.sections.map(s => <section id={s.id} class="case-section" data-case-section>
        <h2>{s.title}</h2>
        {s.paragraphs.map(p => <p>{p}</p>)}
        {s.points && <div class:list={['case-points', { 'case-comparison': s.pointsLayout === 'comparison', 'case-flow': s.pointsLayout === 'flow' }]}>
          {s.points.map((p,i) => <div>
            {s.pointsLayout !== 'comparison' && <span>{String(i+1).padStart(2,'0')}</span>}
            <div><h3>{p.title}</h3><p>{p.text}</p></div>
          </div>)}
        </div>}
        {s.images && <div class:list={['case-gallery',{'gallery-three':s.images.length===3,'gallery-single':s.images.length===1,'gallery-videos':s.images.some(m=>m.kind==='video')}]}>
          {s.images.map(m => <Media src={m.src} alt={m.alt} caption={m.caption} kind={m.kind} poster={m.poster}/>)}
        </div>}
        {s.note && <p class="source-note detail-source">{s.note}</p>}
        {entry.id==='xiaohongshu' && s.id==='next-direction' && <a class="text-link" href="/work/ai-sandbox/">查看广州沙盘的发布与复盘 ↗</a>}
      </section>)}
    </div>
  </div>
  <a class="next-case" href={`/work/${next.id}/`}><div><p class="eyebrow">NEXT CASE / 下一个案例</p><h2>{next.data.shortTitle}</h2><p>{next.data.category}</p></div><span aria-hidden="true">↗</span></a></div>
</Base>
